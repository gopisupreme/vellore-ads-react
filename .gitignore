# Dependencies
/node_modules

# Build output (npm run build writes the React app into backend/app/)
/dist
/backend/app/index.html
/backend/app/static/
*.local

# Vite cache
.vite/

# Test / comparison output (tools/compare.mjs)
/compare-output
/test-results
/playwright-report
/coverage

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Python (tools/finish)
__pycache__/
*.py[cod]

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
*.sw?

# OS
.DS_Store
Thumbs.db

# ---- backend/ (the PHP site, uploaded as public_html) ----
# settings with passwords (see backend/app/config.example.php)
/backend/app/config.php
/backend/application/config/email.local.php
# uploaded media: several GB, lives on the server; keep a local copy for development
/backend/assets/images/
/backend/assets/uploads/
/backend/assets/advertise/
# archives, logs and caches
/backend/**/*.zip
/backend/**/*.tar
/backend/error_log
/backend/application/logs/*
!/backend/application/logs/index.html
/backend/application/cache/*
!/backend/application/cache/index.html
